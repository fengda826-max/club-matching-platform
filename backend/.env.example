# Database — SQLite；sqlite-vec 向量表与业务库共用同一个文件
DATABASE_URL="file:./dev.db"

# Server
PORT=3001
# 开发环境允许任意 localhost 端口（Vite 可能自动切换端口）
CORS_ORIGIN=http://localhost:517*,https://localhost:517*
# 前端单独部署时，在 frontend/.env 配置 VITE_BACKEND_URL
# 示例：VITE_BACKEND_URL=https://api.example.com/api

# AI Configuration — 阿里云百炼 (DashScope, OpenAI-compatible)
# 可选：anthropic 或 openai-compat
AI_PROVIDER=openai-compat
AI_API_KEY=your_dashscope_key_here
# 百炼 (DashScope) OpenAI-compatible endpoint — chat + embeddings 同源
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-flash
# Anthropic 原生：
# AI_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-3-7-sonnet-20250219
AI_TIMEOUT=30000
AI_MAX_RETRIES=2
# AI_TEMPERATURE=0.3

# RAG — 混合检索（向量语义召回 + 规则打分）
# Embedding 走同一个百炼端点；向量存进 sqlite-vec（与业务库同一个 SQLite 文件）
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIM=1024
RAG_ENABLED=true
RAG_TOP_K=5

# 公开演示后台
ADMIN_PASSWORD=replace_with_a_strong_demo_password
SESSION_SECRET=replace_with_a_long_random_secret
COOKIE_SECURE=false
SEED_DEMO_DATA=true

# 本地用 development；仅在部署服务器上设为 production
APP_ENV=development
